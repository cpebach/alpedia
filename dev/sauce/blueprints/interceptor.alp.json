running": false, "memory": {}}}], [4, 1, 21, "steel", {"def": "battery", "dir": 2, "name": "バッテリー1", "state": {"charge": 10000000.0}}], [5, 1, 21, "steel", {"def": "battery", "dir": 2, "name": "バッテリー2", "state": {"charge": 10000000.0}}], [6, 1, 21, "steel", {"def": "battery", "dir": 2, "name": "バッテリー3", "state": {"charge": 10000000.0}}], [7, 1, 21, "steel", {"def": "battery", "dir": 2, "name": "バッテリー4", "state": {"charge": 10000000.0}}], [4, 5, 19, "glass", {"def": "solar_panel", "dir": 2, "name": "太陽光パネル", "state": {"enabled": true}}], [4, 5, 21, "glass", {"def": "solar_panel", "dir": 2, "name": "太陽光パネル", "state": {"enabled": true}}], [7, 5, 19, "glass", {"def": "solar_panel", "dir": 2, "name": "太陽光パネル", "state": {"enabled": true}}], [7, 5, 21, "glass", {"def": "solar_panel", "dir": 2, "name": "太陽光パネル", "state": {"enabled": true}}], [5, 5, 20, "aluminum", {"def": "radar", "dir": 2, "name": "レーダー", "state": {"enabled": true, "data": {}}}], [6, 5, 20, "aluminum", {"def": "antenna", "dir": 2, "name": "アンテナ", "state": {"enabled": true}}], [1, 1, 4, "steel", {"def": "turret", "dir": 4, "name": "砲塔1", "state": {"enabled": true, "data": {}}}], [10, 1, 4, "steel", {"def": "turret", "dir": 4, "name": "砲塔2", "state": {"enabled": true, "data": {}}}], [1, 1, 13, "steel", {"def": "turret", "dir": 4, "name": "砲塔3", "state": {"enabled": true, "data": {}}}], [10, 1, 13, "steel", {"def": "turret", "dir": 4, "name": "砲塔4", "state": {"enabled": true, "data": {}}}], [2, 1, 0, "steel", {"def": "thruster", "dir": 5, "name": "主推進機", "state": {"lit": false}}], [9, 1, 0, "steel", {"def": "thruster", "dir": 5, "name": "主推進機", "state": {"lit": false}}]], "storage": {}, "scripts": {"intercept.blocks.json": "{\n \"format\": \"alpedia-blocks\",\n \"version\": 1,\n \"scripts\": [\n  {\n   \"type\": \"on_tick\",\n   \"body\": [\n    {\n     \"type\": \"turret_aim\",\n     \"dev\": \"*\",\n     \"vec\": {\n      \"type\": \"vsensor\",\n      \"name\": \"nearest_missile\"\n     }\n    },\n    {\n     \"type\": \"if_else\",\n     \"cond\": {\n      \"type\": \"cmp\",\n      \"op\": \">\",\n      \"a\": {\n       \"type\": \"sensor\",\n       \"name\": \"missile_count\"\n      },\n      \"b\": {\n       \"type\": \"num\",\n       \"v\": 0\n      }\n     },\n     \"body\": [\n      {\n       \"type\": \"turret_fire\",\n       \"dev\": \"*\"\n      },\n      {\n       \"type\": \"display\",\n       \"text\": {\n        \"type\": \"join\",\n        \"a\": {\n         \"type\": \"text\",\n         \"v\": \"迎撃の制御\\nミサイル \"\n        },\n        \"b\": {\n         \"type\": \"join\",\n         \"a\": {\n          \"type\": \"sensor\",\n          \"name\": \"missile_count\"\n         },\n         \"b\": {\n          \"type\": \"text\",\n          \"v\": \" 発\"\n         }\n        }\n       },\n       \"width\": {\n        \"type\": \"num\",\n        \"v\": 1.6\n       }\n      }\n     ],\n     \"else\": [\n      {\n       \"type\": \"display\",\n       \"text\": {\n        \"type\": \"text\",\n        \"v\": \"迎撃の制御\\nミサイルなし\"\n       },\n       \"width\": {\n        \"type\": \"num\",\n        \"v\": 1.6\n       }\n      }\n     ]\n    }\n   ]\n  }\n ]\n}", "intercept.py": "\"\"\"このファイルはブロックプログラム intercept.blocks.json から自動生成されました。\nここを直接書き換えても、ブロック側には反映されません。\n\"\"\"\nimport math\nimport random\n\n\ndef _devs(api, name, kind=None):\n    if name == \"*\":\n        return api.devices(kind)\n    return api.devices(name=name)\n\n\ndef _val(api, name, prop, kind=None):\n    ds = _devs(api, name, kind)\n    if not ds:\n        return 0\n    d = ds[0]\n    if prop == \"fuel\":\n        return d.contents.get(\"fuel\", 0)\n    try:\n        return getattr(d, prop)\n    except Exception:\n        return 0\n\n\ndef _div(a, b):\n    return a / b if b else 0\n\n\ndef _round(a):\n    # 無限大（脱出軌道の遠点など）や非数はそのまま（round では止まってしまうため）\n    return round(a) if math.isfinite(a) else a\n\n\ndef _mod(a, b):\n    return a % b if b else 0\n\n\ndef _sin(a):\n    return math.sin(math.radians(a))\n\n\ndef _cos(a):\n    return math.cos(math.radians(a))\n\n\ndef _num(a):\n    try:\n        return float(a)\n    except (TypeError, ValueError):\n        return 0.0\n\n\ndef _gravity(api):\n    p = api.planet()\n    if not p:\n        return 0.0\n    r2 = sum((api.position[i] - p[\"center\"][i]) ** 2 for i in range(3))\n    return p[\"mu\"] / max(r2, 1.0)\n\n\ndef _pos(a):\n    return a if a > 0 else 0.0\n\n\n# --- 矢印（ベクトル）[x, y, z] ---\ndef _V(a):\n    try:\n        return [float(a[0]), float(a[1]), float(a[2])]\n    except (TypeError, ValueError, IndexError, KeyError):\n        return [0.0, 0.0, 0.0]\n\n\ndef _vadd(a, b):\n    return [a[0] + b[0], a[1] + b[1], a[2] + b[2]]\n\n\ndef _vsub(a, b):\n    return [a[0] - b[0], a[1] - b[1], a[2] - b[2]]\n\n\ndef _vmul(a, k):\n    return [a[0] * k, a[1] * k, a[2] * k]\n\n\ndef _vdiv(a, k):\n    return [a[0] / k, a[1] / k, a[2] / k] if k else [0.0, 0.0, 0.0]\n\n\ndef _vdot(a, b):\n    return a[0] * b[0] + a[1] * b[1] + a[2] * b[2]\n\n\ndef _vlen(a):\n    return math.sqrt(_vdot(a, a))\n\n\ndef _vunit(a):\n    n = _vlen(a)\n    return _vmul(a, 1.0 / n) if n > 1e-9 else [0.0, 0.0, 0.0]\n\n\ndef _vclamp(a, n):\n    k = _vlen(a)\n    return _vmul(a, max(n, 0.0) / k) if k > max(n, 0.0) and k > 0 else list(a)\n\n\ndef _vperp(a, b):\n    u = _vunit(b)\n    return _vsub(a, _vmul(u, _vdot(a, u)))\n\n\ndef _vangle(a, b):\n    na, nb = _vlen(a), _vlen(b)\n    if na < 1e-9 or nb < 1e-9:\n        return 0.0\n    return math.degrees(math.acos(max(-1.0, min(1.0, _vdot(a, b) / (na * nb)))))\n\n\ndef _vtilt(a, b, deg):\n    \"\"\"矢印 a の向きを、b から deg 度以内にする（長さはそのまま）。\"\"\"\n    n, u = _vlen(a), _vunit(b)\n    if n < 1e-9 or _vlen(u) < 0.5:\n        return list(a)\n    d = _vmul(a, 1.0 / n)\n    c, cmax = _vdot(d, u), math.cos(math.radians(max(0.0, min(180.0, deg))))\n    if c >= cmax:\n        return list(a)\n    h = _vunit(_vsub(d, _vmul(u, c)))\n    if _vlen(h) < 0.5:\n        return _vmul(u, n) if deg < 90 else list(a)\n    return _vmul(_vadd(_vmul(u, cmax), _vmul(h, math.sin(math.radians(deg)))), n)\n\n\ndef _vship(api, x, y, z):\n    \"\"\"船から見た (右, 上, 前) → ワールドの矢印。\"\"\"\n    X, Y, Z = api.orientation()\n    return [X[i] * x + Y[i] * y + Z[i] * z for i in range(3)]\n\n\ndef _vcomp(api, a, axis):\n    if axis in \"xyz\":\n        return a[\"xyz\".index(axis)]\n    X, Y, Z = api.orientation()\n    return _vdot(a, {\"r\": X, \"u\": Y, \"f\": Z}[axis])\n\n\ndef _vget(v, name):\n    x = v.get(name)\n    return list(x) if isinstance(x, list) and len(x) == 3 else [0.0, 0.0, 0.0]\n\n\ndef _to_planet(api):\n    p = api.planet()\n    return _vsub(p[\"center\"], api.position) if p else [0.0, 0.0, 0.0]\n\n\ndef _txt(a):\n    if isinstance(a, list):\n        return \"(\" + \", \".join(\"%.1f\" % x for x in a) + \")\"\n    return str(a)\n\n\ndef _radio(api, ch):\n    v = api.latest(str(ch))\n    if isinstance(v, bool):\n        return 1.0 if v else 0.0\n    try:\n        return float(v)\n    except (TypeError, ValueError):\n        return 0.0\n\n\n\ndef tick(api):\n    m = api.memory\n    if api.time - m.get('_last', -99.0) > 0.5:   # 起動し直したら最初から\n        m.clear()\n    m['_last'] = api.time\n    v = m.setdefault('vars', {})\n    first = '_t0' not in m\n    if first:\n        m['_t0'] = api.time\n        m['_timer'] = api.time\n    keys = api.input\n    prev = set(m.get('_keys', []))\n    m['_keys'] = sorted(keys)\n    # --- ずっと（0.05秒ごと） ---\n    for d in _devs(api, '*', 'turret'):\n        d.aim(_V(api.nearest_missile()))\n    if (api.missile_count() > 0):\n        for d in _devs(api, '*', 'turret'):\n            d.fire()\n        api.display(str((_txt('迎撃の制御\\nミサイル ') + _txt((_txt(api.missile_count()) + _txt(' 発'))))), width=1.6)\n    else:\n        api.display(str('迎撃の制御\\nミサイルなし'), width=1.6)\n"}}